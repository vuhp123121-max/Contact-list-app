<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    tools:context=".AddEditContact">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/fab"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/colorSurface"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/colorDivider"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thông tin liên hệ"
                    android:textColor="@color/colorTextMain"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Cập nhật thông tin thành viên"
                    android:textColor="@color/colorTextMuted"
                    android:textSize="14sp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="18dp"
                    app:cardBackgroundColor="@color/colorPrimaryContainer"
                    app:cardCornerRadius="44dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/colorTextPrimary"
                    app:strokeWidth="2dp">

                    <ImageView
                        android:id="@+id/profileIv"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/contact_photo"
                        android:padding="22dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_baseline_person_24"
                        app:tint="@color/colorPrimary" />
                </com.google.android.material.card.MaterialCardView>

                <EditText
                    android:id="@+id/nameEt"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/background_input_field"
                    android:drawableStart="@drawable/ic_baseline_text_fields_24"
                    android:drawablePadding="12dp"
                    android:drawableTint="@color/colorTextPrimary"
                    android:hint="@string/contact_name_hint"
                    android:inputType="textPersonName|textCapWords"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true"
                    android:textColor="@color/colorTextMain"
                    android:textColorHint="@color/colorTextMuted"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/phoneEt"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/background_input_field"
                    android:drawableStart="@drawable/ic_baseline_phone_24"
                    android:drawablePadding="12dp"
                    android:drawableTint="@color/colorTextPrimary"
                    android:hint="@string/contact_phone_hint"
                    android:inputType="phone"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true"
                    android:textColor="@color/colorTextMain"
                    android:textColorHint="@color/colorTextMuted"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/emailEt"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/background_input_field"
                    android:drawableStart="@drawable/ic_baseline_email_24"
                    android:drawablePadding="12dp"
                    android:drawableTint="@color/colorTextPrimary"
                    android:hint="@string/contact_email_hint"
                    android:inputType="textEmailAddress"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true"
                    android:textColor="@color/colorTextMain"
                    android:textColorHint="@color/colorTextMuted"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/noteEt"
                    android:layout_width="match_parent"
                    android:layout_height="112dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/background_input_field"
                    android:drawableStart="@drawable/ic_baseline_note_24"
                    android:drawablePadding="12dp"
                    android:drawableTint="@color/colorTextPrimary"
                    android:gravity="top|start"
                    android:hint="@string/contact_note_hint"
                    android:inputType="textCapSentences|textMultiLine"
                    android:padding="14dp"
                    android:textColor="@color/colorTextMain"
                    android:textColorHint="@color/colorTextMuted"
                    android:textSize="15sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </ScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_margin="20dp"
        android:contentDescription="@string/save_contact"
        android:elevation="6dp"
        android:src="@drawable/ic_baseline_add_24"
        app:backgroundTint="@color/colorTextPrimary"
        app:pressedTranslationZ="10dp"
        app:tint="@color/white" />
</RelativeLayout>
